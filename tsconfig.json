{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "synapse-ui": ["src/index.ts"]
    }
  },
  "include": ["src", "playground"],
  "exclude": ["playground/vite.config.ts", "vite.config.ts"]
}
